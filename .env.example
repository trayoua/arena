# Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose in browser code or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=...
# Random 32+ byte hex secrets. Generate separately for production.
ORDER_HASH_SECRET=
ADMIN_SESSION_SECRET=
# Owner admin password: store only the scrypt salt/hash, never the plaintext.
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
# Canonical public site URL, used for email links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mailgun transactional email. Leave empty to keep orders saved without sending email.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=DECUCARE <porachki@your-mailgun-domain.example>
OWNER_NOTIFICATION_EMAIL=owner@example.com
# Use "eu" for a Mailgun EU domain, otherwise "us".
MAILGUN_REGION=us
